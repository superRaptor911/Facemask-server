NODE_ENV=development
PORT=3000

DATABASE_URL="postgresql://postgres@localhost:5432/facemask"

# Web-application OAuth client ID from Google Cloud Console (NOT the Android
# client ID) — the backend verifies ID-token audience against this.
GOOGLE_CLIENT_ID="REPLACE_ME.apps.googleusercontent.com"

# Android package name from Play Console; needed for purchase verification.
PLAY_PACKAGE_NAME=""

# Path to the Play service-account JSON key (Play Developer API access,
# including financial data for voided purchases).
# GOOGLE_APPLICATION_CREDENTIALS="/path/to/play-service-account.json"
